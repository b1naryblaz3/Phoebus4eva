# Public source roots; unlisted local files stay out of commits.
/*
!/.gitignore
!/README.md
!/LICENSE
!/SECURITY.md
!/CONTRIBUTING.md
!/THIRD_PARTY_NOTICES.md
!/build.ps1
!/driver/
!/tests/
!/src/
!/scripts/
!/docs/
!/.github/
/scripts/*
!/scripts/Collect-Phoebus.ps1
!/scripts/build-native-driver.ps1
!/scripts/setup-native-toolchain.py
!/scripts/native-toolchain.lock.json
!/scripts/package-development.py
!/scripts/verify-release.py
!/scripts/publication-files.json
/docs/*
!/docs/build-driver.md
!/docs/driver-package.md
!/docs/driver-status.md
!/docs/testing.md
!/docs/validation.md
__pycache__/
*.pyc
*.user
*.suo
*.dll
*.exe
*.sys
*.lib
*.cat
*.zip
*.pdb
*.obj
